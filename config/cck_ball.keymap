#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 8   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        st: space_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "Space-Tap";
        };
    };
};

/ {
    behaviors {
        boot: bootloader_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&bootloader>, <&kp>;

            display-name = "Bootloader-Tap";
        };

        horz_scroll: horz_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <50>;
            label = "HORZ_SCROLL";
        };

        vert_scroll: vert_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <50>;
            label = "VERT_SCROLL";
        };
    };
};

&mt {
};

&lt {
};

/ {
};

/ {
    combos { compatible = "zmk,combos"; };
};

/ {
    // Up/down scrolling encoder behavior

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp UP>, <&kp DOWN>;

        tap-ms = <50>;
    };

    // Scroll Encoder Behavior Left and Right

    scroll_vol_encoder: scroll_vol_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;

        tap-ms = <50>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        0 {

        bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
   &gresc   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                                         &kp N6   &kp N7   &kp N8   &kp N9   &kp N0  &kp BSPC
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T                                          &kp Y    &kp U    &kp I    &kp O    &kp P   &kp EQUAL
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
&mt LSHFT BSPC  &kp A  &kp S   &kp D    &kp F    &kp G                                          &kp H    &kp J    &kp K     &kp L  &kp SEMI  &kp SQT
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
&mt LCTRL LWIN  &kp Z  &kp X    &kp C    &kp V    &kp B                                          &kp N    &kp M   &kp COMMA &kp DOT  &kp FSLH  &kp ENTER
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
&mt LCTRL LWIN &kp LWIN &kp LALT      &mt LSHFT BSPC &lt 1 ENTER  &mt LALT DEL &mkp LCLK &lt 3 SPACE &st LSHFT SPACE      &kp LALT &kp LEFT &kp RIGHT
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
        >;

        sensor-bindings = <&scroll_vol_encoder>, <&scroll_vertical_encoder>;

        layer_0 {
            bindings = <
&kp ESC           &kp N1        &kp N2        &kp N3    &kp N4       &kp N5        &kp N6     &kp N7    &kp N8     &kp N9              &kp N0              &kp MINUS
&kp TAB           &kp Q         &kp W         &kp E     &kp R        &kp T         &kp Y      &kp U     &kp I      &kp O               &kp P               &kp EQUAL
&kp GRAVE         &kp A         &kp S         &kp D     &kp F        &kp G         &kp H      &kp J     &kp K      &kp L               &kp SEMI            &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C     &kp V        &kp B         &kp N      &kp M     &kp COMMA  &kp DOT             &kp UP              &mt LEFT_SHIFT SLASH
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp BSPC  &lt 2 SPACE  &lt 3 DELETE  &lt 1 RET  &mkp MB1  &kp RET    &mt RIGHT_ALT LEFT  &mt RIGHT_GUI DOWN  &mt RIGHT_CONTROL RIGHT
            >;

            sensor-bindings = <&horz_scroll>, <&vert_scroll>;
        };

        layer_1 {
            bindings = <
&trans  &kp F1        &kp F2        &kp F3         &kp F4        &kp F5         &kp F6      &kp F7  &kp F8  &kp F9  &kp F10       &kp F11
&trans  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PLUS)   &kp LS(AMPS)  &kp LS(POUND)  &trans      &kp N7  &kp N8  &kp N9  &kp FSLH      &kp F12
&trans  &kp LS(LPAR)  &kp LS(RPAR)  &kp MINUS      &kp LS(EXCL)  &kp LS(QMARK)  &trans      &kp N4  &kp N5  &kp N6  &kp LS(PLUS)  &kp EQUAL
&trans  &kp LBKT      &kp RBKT      &kp LS(UNDER)  &kp LS(PIPE)  &kp BSLH       &boot 0 N0  &kp N1  &kp N2  &kp N3  &kp PG_UP     &kp BSLH
&trans  &trans        &trans        &trans         &trans        &trans         &trans      &trans  &trans  &trans  &trans        &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp F6       &kp F7    &kp F8    &kp F9          &kp F10    &kp F11
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans    &trans    &trans          &trans     &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp LEFT  &kp DOWN  &kp UP_ARROW    &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &bootloader  &trans    &kp LBKT  &kp RBKT        &kp UP     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans    &trans    &kp LEFT_BRACE  &kp DOWN   &kp RIGHT_BRACE
            >;
        };

        layer_3 {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &trans      &trans       &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans      &trans       &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans      &trans       &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &bt BT_CLR    &bt BT_CLR  &bootloader  &bootloader  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans      &trans       &trans       &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };

    1 {

    bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
   &kp ESC  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                                         &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &mt F12 BSPC
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &trans &kp LBRC  &kp RBRC   &kp PLUS &kp AMPS &kp HASH                                       &trans   &kp N7  &kp N8   &kp N9  &kp FSLH  &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
&lt 4 BSPC &kp LPAR &kp RPAR   &kp MINUS &lt 3 EXCL &kp QMARK                                   &trans   &kp N4   &kp N5   &kp N6   &kp PLUS &kp DQT
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &trans  &kp LBKT  &kp RBKT  &kp UNDER &kp PIPE &kp BSLH                                     &trans    &kp N1   &kp N2   &kp N3   &kp EQUAL  &trans
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
   &trans    &trans   &trans                      &trans &trans &boot 0 DEL  &mkp LCLK &kp SPACE &kp N0                    &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
    >;

    sensor-bindings = <&scroll_vol_encoder>, <&scroll_vertical_encoder>;
};

2 {
            bindings = <

//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐

&trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans   &trans   &trans   &trans   &trans   &trans                                        &mkp MCLK &trans   &trans   &trans   &trans   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans   &trans   &trans   &trans   &lt 3 F  &trans                                        &mkp RCLK &trans   &trans   &trans   &trans   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans

//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤

&trans   &trans   &trans                     &trans   &trans   &trans    &mkp LCLK &trans   &trans                     &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
            >;
        sensor-bindings = <&scroll_vol_encoder>, <

&scroll_vertical_encoder {
    >;
};

3

    bindings = <

//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐

&kp ESC  &kp F1   &kp F2   &kp N3   &kp N4   &kp F5                                  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &mt F12 BSPC

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans  &trans  &mkp MB4 &mmv MOVE_UP &mkp MB5 &trans                                         &kp F5  &kp F10 &kp UP &kp F11 &kp PSCRN   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans                             &kp HOME  &kp LEFT &kp DOWN &kp RIGHT &kp END &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans   &trans   &trans &trans    &trans   &trans                                       &mkp LCLK &kp PG_DN &kp PG_UP &trans   &trans   &trans

//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤

&trans   &trans   &trans                  &trans &mt LCTRL SPACE &trans   &trans  &trans    &trans                     &trans   &trans   &bt BT_CLR
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
    >;

    sensor-bindings = <&scroll_vol_encoder>, <

&scroll_vertical_encoder {
    >;
};

4

    bindings = <

//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐

&trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans   &trans &mkp MB4 &kp UP   &mkp MB5   &trans                                          &trans &kp AMPS  &kp STAR &kp LPAR &trans   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans  &kp HOME  &kp LEFT &kp DOWN &kp RIGHT &kp END                                      &trans   &kp DLLR &kp PRCNT &kp CARET &trans   &trans

//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤

&trans   &trans   &trans  &kp PG_UP &kp PG_DN &trans                                         &trans &kp EXCL &kp AT   &kp HASH   &trans   &trans

//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤

&trans   &trans   &trans &mt LSHFT SPACE &mt LCTRL BSPC &mt LS(LCTRL) DEL &trans   &trans   &kp RPAR                   &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
    >;

    sensor-bindings = <&scroll_vol_encoder>, <&scroll_vertical_encoder>;
};

};
};
