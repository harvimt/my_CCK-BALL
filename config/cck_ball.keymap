#define ZMK_POINTING_DEFAULT_MOVE_VAL 1600 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&mt {
    tapping-term-ms = <115>;
};

&lt {
    tapping-term-ms = <115>;
};

/ {
    // Up/down scrolling encoder behavior
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        tap-ms = <100>;
    };

    // Scroll Encoder Behavior Left and Right
    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };
    
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
   &kp ESC   &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                                         &kp N6   &kp N7   &kp N8   &kp N9   &kp N0  &kp BSPC
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &kp TAB   &kp Q    &kp W    &kp E    &kp R    &kp T                                          &kp Y    &kp U    &kp I    &kp O    &kp P   &kp EQUAL
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
&mt LSHFT BSPC  &kp A  &kp S  &kp D    &kp F  &kp G                                             &kp H    &kp J    &kp K     &kp L  &kp SEMI  &kp SQT
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
&mt LCTRL BSPC  &kp Z  &kp X    &kp C    &kp V    &kp B                                          &kp N    &kp M   &kp COMMA &kp DOT  &kp FSLH  &kp ENTER
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
&kp LCTRL &kp LWIN &kp LALT        &mt LSHFT BSPC  &lt 1 ENTER  &mt LALT DEL &mt ENTER BSPC &lt 2 &kp SPACE &kp SPACE       &kp LALT &kp DOWN &kp RIGHT
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        f_layers {
            bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
   &kp ESC  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                                         &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &mt F12 BSPC
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &trans    &trans  &trans   &trans   &trans   &trans                                        &mkp MCLK  &kp N7  &kp N8   &kp N9  &kp FSLH  &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &trans    &trans  &lt 4 S    &trans  &lt 3 F  &trans                                       &mkp RCLK &kp N4  &kp N5   &kp N6   &kp PLUS &kp COLON
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
   &trans    &trans   &trans   &trans   &trans   &trans                                        &trans    &kp N1   &kp N2   &kp N3   &kp EQUAL  &trans
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
   &trans    &trans   &trans                  &trans &trans &bootloader    &mkp LCLK &mkp RCLK &kp N0                    &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layers {
            bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                         &trans   &trans   &trans   &trans   &trans   &kp BSPC
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                        &kp F5  &kp F10 &kp UP &kp F11 &kp PSCRN   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
&trans &bt BT_CLR_ALL &trans   &trans   &trans   &trans                                        &kp HOME  &kp LEFT &kp DOWN &kp RIGHT &kp END &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans &bt BT_CLR &trans   &trans                                       &trans &kp PG_DN &kp PG_UP   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
    &trans   &trans   &trans                     &trans   &trans   &trans  &bootloader &trans   &trans                     &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layers {
            bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
    &trans   &trans   &trans                     &trans   &trans   &trans     &trans   &trans   &trans                     &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
            >;
        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe_layers {
            bindings = <
//┌────────┬────────┬────────┬────────┬────────┬────────┐                                     ┌────────┬────────┬────────┬────────┬────────┬────────┐
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┼────────┼────────┤                                     ├────────┼────────┼────────┼────────┼────────┼────────┤
    &trans   &trans   &trans   &trans   &trans   &trans                                         &trans   &trans   &trans   &trans   &trans   &trans
//├────────┼────────┼────────┼────────┴────────┼────────┼────────┬────────┐ ┌────────┬────────┼────────┼────────┴────────┼────────┼────────┼────────┤
    &trans   &trans   &trans                     &trans   &trans   &trans     &trans   &trans   &trans                     &trans   &trans   &trans
//└────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘ └────────┴────────┴────────┘       [=]       └────────┴────────┴────────┘
            >;
            sensor-bindings = <&scroll_vertical_encoder>,                                       <&scroll_horizontal_encoder>;
            // Encoder 1: Scroll up and down                                                   Encoder 2: Scroll left and right
        };
    };
};
